# ------------------------------------------------------------------
# Copy to .env and fill in ONLY if you want Live GLM mode.
# The app runs fully in Offline Mode with NO key and NO .env file.
# ------------------------------------------------------------------

# Provider selection: "glm" (live) or "offline". Default: auto-detect
# (glm if a key is present, otherwise offline).
LLM_PROVIDER=auto

# --- Live GLM (Zhipu AI / Z.ai), OpenAI-compatible ---
# Get a free key at https://open.bigmodel.cn (CN) or https://z.ai (international)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Free-tier model (verified 2026-10-19, see decision.md D-004):
GLM_MODEL=glm-4-flash
