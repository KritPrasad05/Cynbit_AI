# ------------------------------------------------------------------
# Copy to .env and fill in ONLY if you want Live Groq mode.
# The app runs fully in Offline Mode with NO key and NO .env file.
# ------------------------------------------------------------------

# Provider selection: "groq" (live) or "offline". Default: auto-detect
# (groq if a key is present, otherwise offline).
# Note: "glm" is accepted as a deprecated alias for "groq" (decision.md D-026).
LLM_PROVIDER=auto

# --- Live Groq (https://console.groq.com), OpenAI-compatible endpoint ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Production models verified 2026-10-20 (see decision.md D-026):
#   openai/gpt-oss-120b (default) | openai/gpt-oss-20b (faster)
# Free-tier limits per model: 30 req/min, 1K req/day, 8K tokens/min,
# 200K tokens/day (console.groq.com/docs/rate-limits).
GROQ_MODEL=openai/gpt-oss-120b
